pe":"stream"}],"execution_count":4},{"cell_type":"code","source":"# ============================================================================\n# BÖLÜM 3: ÖZELLİK ÇIKARMA FONKSİYONLARI\n# ============================================================================\n \nprint(\"\\n[3/12] Özellik Çıkarma Fonksiyonları Hazırlanıyor...\")\n \n# İngilizce'de sık kullanılan bigram ve trigramlar\nCOMMON_BIGRAMS = {\n    'th', 'he', 'in', 'er', 'an', 're', 'on', 'at', 'en', 'nd',\n    'ti', 'es', 'or', 'te', 'of', 'ed', 'is', 'it', 'al', 'ar',\n    'st', 'to', 'nt', 'ng', 'se', 'ha', 'as', 'ou', 'io', 'le'\n}\n \nCOMMON_TRIGRAMS = {\n    'the', 'and', 'ing', 'ion', 'tio', 'ent', 'ati', 'for',\n    'her', 'ter', 'tha', 'ere', 'ate', 'his', 'con', 'res',\n    'ver', 'all', 'ons', 'nce', 'men', 'thi', 'est', 'ers',\n    'pro', 'com', 'nte', 'int', 'rea', 'are'\n}\n \ndef calculate_entropy(domain):\n    \"\"\"\n    Shannon Entropy hesaplama\n    H = -Σ p(c) * log2(p(c))\n    \n    DGA domainleri: H > 3.5 (yüksek entropi, düzensiz)\n    Benign domainleri: H ≈ 2.8 (düşük entropi, linguistik yapı)\n    \"\"\"\n    # Second-Level Domain (SLD) kısmını al\n    sld = str(domain).split('.')[0]\n    \n    if not sld or len(sld) == 0:\n        return 0.0\n    \n    # Karakter frekanslarını hesapla\n    char_counts = Counter(sld)\n    length = len(sld)\n    \n    # Olasılık dağılımı\n    probabilities = [count / length for count in char_counts.values()]\n    \n    # Shannon entropy\n    entropy = -sum(p * math.log2(p) for p in probabilities if p > 0)\n    \n    return entropy\n \n \ndef extract_features(domain):\n    \"\"\"\n    12 karakter-seviye özellik çıkarımı\n    \n    Özellikler (Dokümanda belirtildiği gibi):\n    1. Domain uzunluğu\n    2. Shannon entropy\n    3. Rakam oranı\n    4. Sesli harf oranı\n    5. Sessiz harf oranı\n    6. Tire (-) oranı\n    7. Benzersiz karakter oranı\n    8. İngilizce bigram frekans oranı\n    9. İngilizce trigram frekans oranı\n    10. Ardışık aynı karakter sayısı (maksimum)\n    11. Rakam blok sayısı\n    12. Sesli-sessiz geçiş oranı\n    \"\"\"\n    \n    # SLD'yi al ve küçük harfe çevir\n    domain = str(domain).split('.')[0].lower()\n    length = len(domain)\n    \n    if length == 0:\n        return [0] * 12\n    \n    # 1. Uzunluk\n    domain_length = length\n    \n    # 2. Shannon Entropy\n    entropy = calculate_entropy(domain)\n    \n    # 3. Rakam oranı\n    digit_count = sum(c.isdigit() for c in domain)\n    digit_ratio = digit_count / length\n    \n    # 4. Sesli harf oranı\n    vowel_count = sum(c in 'aeiou' for c in domain)\n    vowel_ratio = vowel_count / length\n    \n    # 5. Sessiz harf oranı\n    consonant_count = sum(c in 'bcdfghjklmnpqrstvwxyz' for c in domain)\n    consonant_ratio = consonant_count / length\n    \n    # 6. Tire oranı\n    hyphen_count = domain.count('-')\n    hyphen_ratio = hyphen_count / length\n    \n    # 7. Benzersiz karakter oranı\n    unique_chars = len(set(domain))\n    unique_ratio = unique_chars / length\n    \n    # 8. İngilizce bigram frekans oranı\n    bigrams = [domain[i:i+2] for i in range(length-1)]\n    if bigrams:\n        common_bigram_count = sum(1 for bg in bigrams if bg in COMMON_BIGRAMS)\n        bigram_ratio = common_bigram_count / len(bigrams)\n    else:\n        bigram_ratio = 0.0\n    \n    # 9. İngilizce trigram frekans oranı\n    trigrams = [domain[i:i+3] for i in range(length-2)]\n    if trigrams:\n        common_trigram_count = sum(1 for tg in trigrams if tg in COMMON_TRIGRAMS)\n        trigram_ratio = common_trigram_count / len(trigrams)\n    else:\n        trigram_ratio = 0.0\n    \n    # 10. Ardışık aynı karakter (maksimum)\n    import itertools\n    consecutive_groups = [len(list(g)) for k, g in itertools.groupby(domain)]\n    max_consecutive = max(consecutive_groups) if consecutive_groups else 0\n    \n    # 11. Rakam blok sayısı\n    digit_blocks = len(re.findall(r'\\d+', domain))\n    \n    # 12. Sesli-sessiz geçiş oranı\n    transitions = 0\n    for i in range(length - 1):\n        current_is_vowel = domain[i] in 'aeiou'\n        next_is_vowel = domain[i+1] in 'aeiou'\n        \n        # Bir sesli harf varken diğeri sessiz ise geçiş var\n        if current_is_vowel != next_is_vowel:\n            transitions += 1\n    \n    transition_ratio = transitions / (length - 1) if length > 1 else 0.0\n    \n    return [\n        domain_length, entropy, digit_ratio, vowel_ratio, consonant_ratio,\n        hyphen_ratio, unique_ratio, bigram_ratio, trigram_ratio,\n        max_consecutive, digit_blocks, transition_ratio\n    ]\n \n# Özellik isimleri\nFEATURE_NAMES = [\n    'length', 'entropy', 'digit_ratio', 'vowel_ratio', 'consonant_ratio',\n    'hyphen_ratio', 'unique_ratio', 'bigram_ratio', 'trigram_ratio',\n    'max_consecutive', 'digit_blocks', 'transition_ratio'\n]\n \nprint(f\"✓ 12 özellik tanımlandı: {', '.join(FEATURE_NAMES[:4])}...\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-03T18:56:07.383800Z","iopub.execute_input":"2026-05-03T18:56:07.384499Z","iopub.status.idle":"2026-05-03T18:56:07.397924Z","shell.execute_reply.started":"2026-05-03T18:56:07.384468Z","shell.execute_reply":"2026-05-03T18:56:07.397208Z"}},"outputs":[{"name":"stdout","text":"\n[3/12] Özellik Çıkarma Fonksiyonları Hazırlanıyor...\n✓ 12 özellik tanımlandı: length, entropy, digit_ratio, vowel_ratio...\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# ============================================================================\n# BÖLÜM 4: ÖZELLİKLERİ HESAPLA\n# ============================================================================\n \nprint(\"\\n[4/12] Tüm Domainler İçin Özellikler Hesaplanıyor...\")\nprint(\"(Bu işlem 1-2 dakika sürebilir...)\")\n \n# Özellikleri çıkar\nfeature_matrix = df_balanced['domain'].apply(extract_features).tolist()\nX = pd.DataFrame(feature_matrix, columns=FEATURE_NAMES)\ny = df_balanced['isDGA'].values\n \nprint(f\"✓ Özellik matrisi boyutu: {X